# Yerel embedding modeli; ilk çalıştırmada makineye indirilir, sonraki çağrılar yereldir.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama yerel servis ayarları
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=90

# RAG ayarları
CHROMA_COLLECTION=onboarding_documents
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_MIN_SCORE=0.12
